# ============================================================
# NGA Manufacturing Assistant — Environment Configuration
# ============================================================

# Execution environment selector: Local (Ollama) or Cloud (OpenRouter)
EXECUTION_ENVIRONMENT=Cloud

# --- Ollama (used when EXECUTION_ENVIRONMENT=Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OpenRouter (used when EXECUTION_ENVIRONMENT=Cloud) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings (via OpenRouter)
EMBEDDING_MODEL=qwen/qwen3-embedding-4b

# --- 3-Tier LLM Routing ---
RAG_TIER1_MODEL=anthropic/claude-haiku-4-5
RAG_TIER2_MODEL=anthropic/claude-sonnet-4-5
RAG_TIER3_MODEL=anthropic/claude-opus-4-5

RAG_TIER1_CONTEXT_WINDOW=8000
RAG_TIER2_CONTEXT_WINDOW=32000
RAG_TIER3_CONTEXT_WINDOW=200000

RAG_TIER1_THRESHOLD_MIN=0
RAG_TIER1_THRESHOLD_MAX=3
RAG_TIER2_THRESHOLD_MIN=4
RAG_TIER2_THRESHOLD_MAX=6
RAG_TIER3_THRESHOLD_MIN=7
RAG_TIER3_THRESHOLD_MAX=10

RAG_TIER1_MAX_HOPS=1
RAG_TIER2_MAX_HOPS=3
RAG_TIER3_MAX_HOPS=8

# --- NGA Database & Storage Paths ---
NGA_DB_PATH=database/nga.db
APP_STATE_DB_PATH=data/app_state.db
VECTOR_STORE_DIR=data/vector_store
GRAPH_STORE_DIR=data/graph_store

# --- Authentication ---
JWT_SECRET=change-me-in-production
JWT_DEV_MODE=true

# --- LangSmith Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nga-manufacturing-assistant

# --- Logging ---
LOG_LEVEL=INFO
