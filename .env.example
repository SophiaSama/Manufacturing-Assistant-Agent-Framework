# ============================================================
# Enterprise Agentic Framework — Environment Configuration
# ============================================================

# --- Execution Environment Selector ---
# Options: Local (Ollama) or Cloud (OpenRouter)
EXECUTION_ENVIRONMENT=Cloud

# --- Ollama (used when EXECUTION_ENVIRONMENT=Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OpenRouter (used when EXECUTION_ENVIRONMENT=Cloud) ---
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings (via OpenRouter) ---
EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# Embedding strategy: sequential (sync) or batch (async polling)
EMBEDDING_STRATEGY=sequential

# --- 3-Tier LLM Model Routing ---
RAG_TIER1_MODEL=anthropic/claude-haiku-4-5
RAG_TIER2_MODEL=anthropic/claude-sonnet-4-5
RAG_TIER3_MODEL=anthropic/claude-opus-4-5

RAG_TIER1_CONTEXT_WINDOW=8000
RAG_TIER2_CONTEXT_WINDOW=32000
RAG_TIER3_CONTEXT_WINDOW=200000

RAG_TIER1_THRESHOLD_MIN=0
RAG_TIER1_THRESHOLD_MAX=3
RAG_TIER2_THRESHOLD_MIN=4
RAG_TIER2_THRESHOLD_MAX=6
RAG_TIER3_THRESHOLD_MIN=7
RAG_TIER3_THRESHOLD_MAX=10

RAG_TIER1_MAX_HOPS=1
RAG_TIER2_MAX_HOPS=3
RAG_TIER3_MAX_HOPS=8

# --- Pluggable Domain Pack ---
# Specify which domain configuration pack to load (e.g., manufacturing, banking, healthcare)
DOMAIN_PACK=domains/manufacturing/pack.yaml
# Alternate example: DOMAIN_PACK=domains/banking/pack.yaml

# --- Jev Reranker (TypeSafe) ---
# Set your TypeSafe API key (get one at https://console.typesafe.ai/)
TYPESAFE_API_KEY=your-typesafe-api-key

# Enable or disable reranking (defaults to true if TYPESAFE_API_KEY is set)
RERANK_ENABLED=true

# TypeSafe Jev model for reranking
RERANK_MODEL=jev-1.12

# Number of top reranked chunks to return to the agent context
RERANK_TOP_N=5

# --- Database & Storage Paths ---
NGA_DB_PATH=database/nga.db
APP_STATE_DB_PATH=data/app_state.db
VECTOR_STORE_DIR=data/vector_store
GRAPH_STORE_DIR=data/graph_store
GRAPH_MAX_DOCS=0  # 0 = process all chunks; set to e.g. 50 to limit during testing

# --- Corpus Profile (docs/variant-corpus-ingestion-design.md) ---
# CORPUS_PROFILE=main        # main | variant | conflict
# VARIANT_CORPUS_DIR=variant-corpus
# VARIANT_VECTOR_STORE_DIR=data/variant_vector_store
# CONFLICT_VECTOR_STORE_DIR=data/conflict_vector_store

# --- Authentication & RBAC ---
JWT_SECRET=change-me-in-production
JWT_DEV_MODE=true

# --- LangSmith Tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nga-manufacturing-assistant

# --- Logging ---
LOG_LEVEL=INFO

# --- Model capability gating for integration tests (docs/model-capability-gating-design.md) ---
# MODEL_CAPABILITY_OVERRIDE=strong   # force tier: basic | standard | strong (else auto-detect)
# Run integration with a runtime probe: pytest --probe-capability

# --- Cache (docs/cache-design.md) ---
# CACHE_ENABLED=true      # master switch (default false → no caching)
# CACHE_MODE=cold         # eval default: cold | hot
# CACHE_DB_PATH=data/cache/nga_cache.db
# CACHE_EVAL_DB_PATH=data/cache/eval_cache.db
# CACHE_TTL_EMB_S=86400   # embedding entries (1 day)
# CACHE_TTL_RETR_S=3600   # retrieval entries (1 hour)
# CACHE_TTL_SQL_S=300     # SQL entries (5 min; DB etag handles invalidation)
# CACHE_MAX_ENTRIES=100000
